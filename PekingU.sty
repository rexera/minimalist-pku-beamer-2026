% ---- 固定高度顶栏（对 smoothbars 的修补）----
% 仅做三件事：① 去掉原版顶栏/标题条之间的模糊渐变过渡；② 固定条带高度（原版无标题的
% 分节目录页会比正文页高一截）；③ 配色统一为 peking。导航条内部几何（文字/圆点行位置、
% 0.3cm 内边距、字号）完全保留原版：条带高度 = 原版 barshade 的 6ex（同样在
% \AtBeginDocument 的 headline 字体上下文中求值），导航行经像素校准锚定在原版位置
% （tab 文字基线 y≈6.01pt，pdftotext -bbox 对照原版误差 <0.01pt）。
% 右上角校徽（Figures/PKU-emblem-names.png，墨迹紧贴画布）以墨迹对齐
% 标题文字：高度 = 当前标题的墨迹高度（\settoheight + \settodepth），
% 顶边锚定在标题墨迹顶线，与标题文字严格同高对齐。
\makeatletter
\newlength{\pku@headheight}
\newlength{\pku@titleht}
\newlength{\pku@titledp}
\newlength{\pku@logoheight}
\newlength{\pku@logowidth}
\newlength{\pku@logoyshift}
% 顶部导航条统一为主题红 peking（原继承 palette quaternary，为更暗的红，
% 与底部栏 / 首页标题 box 的纯 peking 不一致）
\setbeamercolor{section in head/foot}{bg=peking,fg=white}
\setbeamercolor{section in head/foot shaded}{bg=peking,fg=white!55!peking}
% 条带高度：内容块（tab 文字 + mini-frame 圆点行，约 10.2pt）上下各留 ~1pt 呼吸空间，
% 像素校准为 11.6pt（原版 6ex 在不同字体上下文下求值结果偏大，导致底部空 ~8px）
\AtBeginDocument{\global\pku@headheight=11.6pt}
\setbeamertemplate{headline}
{%
  \begin{beamercolorbox}[wd=\paperwidth,colsep=0pt,ht=\pku@headheight,dp=0ex,vmode]{section in head/foot}%
    \vbox to \pku@headheight{%
      {\vskip0.52pt}%  % 导航行锚定：像素校准至原版 tab 基线（y=6.01pt，见上方注释）
      \insertnavigation{\paperwidth}%
      \vss}%
  \end{beamercolorbox}%
}
\setbeamertemplate{frametitle}
{%
  \nointerlineskip
  \usebeamerfont*{frametitle}%
  \settoheight{\pku@titleht}{\insertframetitle}%
  \settodepth{\pku@titledp}{\insertframetitle}%
  \pku@logoheight=\dimexpr\pku@titleht+\pku@titledp\relax
  \settowidth{\pku@logowidth}{\includegraphics[height=\pku@logoheight]{Figures/PKU-emblem-names.png}}%
  \begin{beamercolorbox}[wd=\paperwidth,sep=0.3cm,%
    rightskip=\dimexpr\pku@logowidth+0.4cm\relax]{frametitle}%
    \strut\insertframetitle
    \ifx\insertframesubtitle\@empty\else
      \par{\usebeamerfont*{framesubtitle}\usebeamercolor[fg]{framesubtitle}\strut\insertframesubtitle}%
    \fi
  \end{beamercolorbox}%
  \nointerlineskip
  \pku@logoyshift=\pku@headheight
  \addtolength{\pku@logoyshift}{0.3cm}%
  \addtolength{\pku@logoyshift}{\ht\strutbox}%
  \addtolength{\pku@logoyshift}{-\pku@titleht}%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north east,inner sep=0pt]
      at ([yshift=-\pku@logoyshift,xshift=-0.3cm]current page.north east)
      {\includegraphics[height=\pku@logoheight]{Figures/PKU-emblem-names.png}};
  \end{tikzpicture}%
}
\makeatother

% 三线表（booktabs）主题：头尾粗线 1.2pt，中间线 0.5pt，与正文形成明显层次；
% 表头建议用 \textbf 加粗（默认即黑色，不继承任何主题色）。
% booktabs 在 main.tex 中晚于本文件加载，故延迟到导言区末尾设置。
\makeatletter
\AtEndPreamble{\@ifpackageloaded{booktabs}{%
  \setlength{\heavyrulewidth}{1.2pt}%
  \setlength{\lightrulewidth}{0.5pt}%
}{}}
\makeatother

